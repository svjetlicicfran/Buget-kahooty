{
  "compilerOptions": {
    // Target ECMAScript version for emitted JavaScript.
    // ES2020 is a good balance for modern Node.js environments.
    "target": "es2020",

    // Specify module code generation: CommonJS is standard for Node.js.
    "module": "commonjs",

    // Directory to output compiled JavaScript files.
    "outDir": "./dist",

    // Root directory of source files.
    "rootDir": "./src",

    // Enable all strict type-checking options.
    "strict": true,

    // Enables emit interoperability between CommonJS and ES Modules.
    "esModuleInterop": true,

    // Skip type checking of all declaration files (*.d.ts).
    "skipLibCheck": true,

    // Ensure that casing is consistent in file names.
    "forceConsistentCasingInFileNames": true,

    // Allow importing modules with a .json extension.
    "resolveJsonModule": true,

    // Emit corresponding .map files for source maps.
    "sourceMap": true,

    // List of library files to be included in the compilation.
    "lib": ["es2020"],

    // Type declaration files to be included in compilation.
    "types": ["node"]
  },
  // Specify an array of filenames or patterns to include in the program.
  "include": ["src/**/*.ts"],

  // Specify an array of filenames or patterns that should be skipped when compiling.
  "exclude": ["node_modules", "dist"],

  // ts-node specific options for faster development.
  "ts-node": {
    // Use TypeScript's faster `transpileModule` which skips type-checking.
    // Type-checking can be done separately (e.g., as part of a build step or linting).
    "transpileOnly": true,
    
    // Load "files" and "include" from `tsconfig.json` on startup.
    // This ensures all files are considered for type information, even if not directly imported.
    "files": true
  }
}